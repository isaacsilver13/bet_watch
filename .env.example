# Copy this file to .env for local development. Fixture mode (below) is the
# safe default: it never makes a real network call or spends API quota.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Deterministic fixture provider — no live network calls, no cost.
PROVIDER_MODE=fixture
ODDS_PROVIDER=fixture

DATABASE_URL=postgresql+asyncpg://betting_aggregator:betting_aggregator@127.0.0.1:5433/betting_aggregator
PERSISTENCE_ENABLED=true
OBSERVATION_RETENTION_DAYS=90
# In-memory reuse window for provider fetches. Opening /odds never fetches (it reads the stored
# snapshot); this only matters for repeated refresh-gated requests in one process.
CACHE_TTL_SECONDS=86400
PROVIDER_MIN_QUOTA_REMAINING=5
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_SECONDS=0.5

# To hit real NFL/NBA lines instead of fixtures, set a real key and switch
# both lines above to PROVIDER_MODE=live / ODDS_PROVIDER=the_odds_api.
# Never commit a real key.
THE_ODDS_API_KEY=

# The scheduled odds_snapshot jobs (run-due) spend 3 credits per call. NFL: Tue/Thu/Sat/Sun 10am CT
# and 30 minutes before each kickoff time, about 30 credits a week. NBA: 10am CT daily and before
# the first and last tip of each night, about 9 credits a day. They share one pool, only run when
# PROVIDER_MODE=live and a key is set, and stop at PROVIDER_MIN_QUOTA_REMAINING.

# Admin secret for expensive provider actions (force_refresh, include_props, /health/errors,
# quota figures). Send it as the X-Admin-Token header. Set via `fly secrets set`, never commit.
# Unset = only the owner's machine (loopback, no forwarding header) may spend; others get the
# stored snapshot.
ADMIN_REFRESH_SECRET=
# Optional authenticated NBA forecast intake. Set a distinct secret on the app and producer
# only when moving prediction delivery from the local file to POST /api/v1/internal/nba-predictions.
NBA_PREDICTION_INGEST_SECRET=
# Hard cap on admin-triggered live refreshes per window (process-local). Tune to your plan's
# provider quota (about 3 credits per sport per refresh on the free tier).
ADMIN_REFRESH_BUDGET=4
ADMIN_REFRESH_BUDGET_WINDOW_SECONDS=86400

# Sportsbook coverage from The Odds API. ODDS_BOOKMAKERS (allowlist) overrides ODDS_REGIONS.
# Up to 10 books count as one region for quota. Verify keys at
# https://the-odds-api.com/sports-odds-data/bookmaker-apis.html before changing.
# Free-tier books only (verified 2026-10-11): Caesars (williamhill_us) and Fanatics are paid-only
# and are not used. espnbet is theScore Bet (us2 region); an allowlist spans regions.
ODDS_REGIONS=us
ODDS_BOOKMAKERS=draftkings,fanduel,betmgm,betrivers,espnbet

# Read-only Kalshi prediction-market data (public endpoint, no key). Off by default. In fixture
# mode this serves committed sample payloads; in live mode it polls Kalshi at most once per TTL.
KALSHI_ENABLED=false
KALSHI_CACHE_TTL_SECONDS=300
# Official public Trade API host. HTTPS only; no credentials are sent.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Where paid/raw provider payloads are written before parsing (gitignored). Empty = <repo>/data/raw.
RAW_DATA_DIR=

# Single-owner login for private hosting. Generate OWNER_PASSWORD_HASH locally with
# `python -m app.api.owner_auth` after the repo is installed, or see docs/owner-access.md.
# Keep the hash in the secrets manager; never store a plaintext password in .env.
# OWNER_APP_ORIGIN is the exact HTTPS origin of the private app (no trailing slash).
OWNER_PASSWORD_HASH=
OWNER_APP_ORIGIN=

# Owner-only NBA digest. The first private test uses AIsaac's current sender.
# Delivery still needs the existing account key and owner recipient from secrets.
RESEND_API_KEY=
NBA_NEWSLETTER_FROM_EMAIL=AIsaac <onboarding@resend.dev>
NBA_NEWSLETTER_TO_EMAIL=
